{% from "_bt_macros.html" import bt_chart, metrics_table, epic_table, grid_table %}
<!doctype html>
<html lang="en">
<head>
<title>{{ a.name }} vs {{ b.name }} · {{ a.project }}</title>
{% include "_bt_page.html" %}
</head>
<body><main>
<h1>{{ a.name }} vs {{ b.name }}</h1>
<p class="bt-muted">{{ a.project }} · {{ a.model }} vs {{ b.model }}</p>
{% if a.steps != b.steps %}<p class="bt-muted">The two backtests used different step dates, so compare metrics rather than individual weeks.</p>{% endif %}

<h2>Metrics</h2>
{{ metrics_table(evs) }}

<h2>Per epic</h2>
{{ epic_table(evs) }}

{% for ev in evs %}
<h2>{{ ev.name }} · {{ ev.model }}</h2>
{{ bt_chart(chart(ev), ev.name) }}
{% endfor %}
</main></body>
</html>
