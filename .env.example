# Copy to .env (or run `pewa init`). Every value is optional: with no credentials,
# `pewa ingest` uses the bundled Atlas fixtures. Tokens are read from the environment only.

# --- LLM ---
ANTHROPIC_API_KEY=
PEWA_MODEL=claude-sonnet-5-5

# --- Storage ---
PEWA_DB_PATH=pewa.db
# Project name used by `pewa snapshot` / `assess` when --project is not given.
PEWA_PROJECT=atlas

# --- Jira Cloud (read-only; email + API token) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- GitHub (fine-grained, read-only token) ---
GITHUB_TOKEN=
# Comma-separated owner/repo list
GITHUB_REPOS=

# --- Slack (bot token, read scopes only) ---
SLACK_BOT_TOKEN=
# Comma-separated channel ids
SLACK_CHANNELS=

# --- Signal thresholds ---
PEWA_STALE_REVIEW_DAYS=3
PEWA_STALE_TICKET_DAYS=5
PEWA_SCOPE_GROWTH_PCT=20
PEWA_CI_FLAKY_FAILURES=2
PEWA_OWNER_OVERLOAD_N=3
PEWA_BURN_WINDOW_WEEKS=4
