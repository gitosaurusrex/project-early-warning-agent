# Copy to .env (or run `pewa init`). Every value is optional: with no credentials,
# `pewa ingest` uses the bundled Atlas fixtures. Tokens are read from the environment only.

# --- LLM ---
ANTHROPIC_API_KEY=
# Same key under a pewa-specific name; use this where ANTHROPIC_API_KEY is reserved
# (e.g. Claude Code cloud environments). Takes precedence when both are set.
PEWA_ANTHROPIC_API_KEY=
PEWA_MODEL=claude-sonnet-5-5

# --- Storage ---
PEWA_DB_PATH=pewa.db
# Project name used by `pewa snapshot` / `assess` when --project is not given.
PEWA_PROJECT=atlas

# --- Jira Cloud (read-only; email + API token) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Story points custom field id (Settings > Issues > Custom fields)
JIRA_POINTS_FIELD=customfield_10016
# Optional: classic "Epic Link" field id, for projects that don't use `parent`
# JIRA_EPIC_LINK_FIELD=customfield_10014
# Optional: map Jira statuses onto To Do / In Progress / In Review / Done
# JIRA_STATUS_MAP=Code Review=In Review,Ready for QA=In Review

# --- GitHub (fine-grained, read-only token) ---
GITHUB_TOKEN=
# Comma-separated owner/repo list
GITHUB_REPOS=
# Optional: GitHub Enterprise Server API root
# GITHUB_API_URL=https://ghe.example.com/api/v3

# --- Slack (bot token, read scopes only) ---
SLACK_BOT_TOKEN=
# Comma-separated channel ids
SLACK_CHANNELS=
# Incremental syncs re-read threads started this many days before the last sync
SLACK_THREAD_LOOKBACK_DAYS=14

# --- Signal thresholds ---
PEWA_STALE_REVIEW_DAYS=3
PEWA_STALE_TICKET_DAYS=5
PEWA_SCOPE_GROWTH_PCT=20
PEWA_CI_FLAKY_FAILURES=2
PEWA_OWNER_OVERLOAD_N=3
PEWA_BURN_WINDOW_WEEKS=4
# Window for reopened / ci_flaky / blocker_language signals
PEWA_SIGNAL_LOOKBACK_DAYS=14
# Thin-history guard: until an epic has this much history, amber/red needs a severity 2+ signal
# (unless due within two working weeks). PEWA_MIN_HISTORY_WEEKS=0 turns it off.
PEWA_MIN_HISTORY_WEEKS=2
PEWA_MIN_DONE_TICKETS=3
# Comma-separated; leave unset for the defaults ("blocked on", "waiting on", "can't proceed", ...)
# PEWA_BLOCKER_PHRASES=blocked on,waiting on,can't proceed
